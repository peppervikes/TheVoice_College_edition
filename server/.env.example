# Server Environment Variables
# Copy this file to .env and fill in the values

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Get this from: Atlas Dashboard > Database > Connect > Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# Google OAuth (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Sentry DSN (optional — for error tracking)
# Get from: sentry.io > Your Project > Settings > Client Keys
SENTRY_DSN=
